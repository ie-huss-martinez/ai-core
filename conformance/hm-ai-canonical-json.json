{
  "format": "hm-conformance",
  "version": 1,
  "subject": "hm-ai-canonical-json",
  "description": "The JSON Canonicalization Scheme (RFC 8785) as ai-core implements it for the context hash (docs/formats/hm-ai-context-hash.md). input is jsonText, JSON text to parse and canonicalise, or ieee754, the hex bits of one double. expected is the canonical JSON text, its UTF-8 bytes in hex when output is utf8-hex, or the rejection. The RFC cases are its own samples, verbatim.",
  "cases": [
    {
      "name": "RFC 8785 3.2.2 and 3.2.3: the sample, parsed and canonicalised",
      "input": {
        "jsonText": "{\n  \"numbers\": [333333333.33333329, 1E30, 4.50,\n              2e-3, 0.000000000000000000000000001],\n  \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n  \"literals\": [null, true, false]\n}"
      },
      "expected": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"\u20ac$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}"
    },
    {
      "name": "RFC 8785 3.2.4: the sample's canonical form as UTF-8 bytes",
      "input": {
        "jsonText": "{\n  \"numbers\": [333333333.33333329, 1E30, 4.50,\n              2e-3, 0.000000000000000000000000001],\n  \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n  \"literals\": [null, true, false]\n}",
        "output": "utf8-hex"
      },
      "expected": "7b226c69746572616c73223a5b6e756c6c2c747275652c66616c73655d2c226e756d62657273223a5b3333333333333333332e333333333333332c31652b33302c342e352c302e3030322c31652d32375d2c22737472696e67223a22e282ac245c75303030665c6e4127425c225c5c5c5c5c222f227d"
    },
    {
      "name": "RFC 8785 3.2.3: property names sorted by UTF-16 code units",
      "input": {
        "jsonText": "{\n  \"\\u20ac\": \"Euro Sign\",\n  \"\\r\": \"Carriage Return\",\n  \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n  \"1\": \"One\",\n  \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n  \"\\u0080\": \"Control\",\n  \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n}"
      },
      "expected": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"}"
    },
    {
      "name": "RFC 8785 3.2.3: \"\", \"a\", \"aa\", \"ab\" in that order",
      "input": {
        "jsonText": "{\"ab\":4,\"aa\":3,\"a\":2,\"\":1}"
      },
      "expected": "{\"\":1,\"a\":2,\"aa\":3,\"ab\":4}"
    },
    {
      "name": "RFC 8785 Appendix B: 0000000000000000 (Zero)",
      "input": {
        "ieee754": "0000000000000000"
      },
      "expected": "0"
    },
    {
      "name": "RFC 8785 Appendix B: 8000000000000000 (Minus zero)",
      "input": {
        "ieee754": "8000000000000000"
      },
      "expected": "0"
    },
    {
      "name": "RFC 8785 Appendix B: 0000000000000001 (Min pos number)",
      "input": {
        "ieee754": "0000000000000001"
      },
      "expected": "5e-324"
    },
    {
      "name": "RFC 8785 Appendix B: 8000000000000001 (Min neg number)",
      "input": {
        "ieee754": "8000000000000001"
      },
      "expected": "-5e-324"
    },
    {
      "name": "RFC 8785 Appendix B: 7fefffffffffffff (Max pos number)",
      "input": {
        "ieee754": "7fefffffffffffff"
      },
      "expected": "1.7976931348623157e+308"
    },
    {
      "name": "RFC 8785 Appendix B: ffefffffffffffff (Max neg number)",
      "input": {
        "ieee754": "ffefffffffffffff"
      },
      "expected": "-1.7976931348623157e+308"
    },
    {
      "name": "RFC 8785 Appendix B: 4340000000000000 (Max pos int)",
      "input": {
        "ieee754": "4340000000000000"
      },
      "expected": "9007199254740992"
    },
    {
      "name": "RFC 8785 Appendix B: c340000000000000 (Max neg int)",
      "input": {
        "ieee754": "c340000000000000"
      },
      "expected": "-9007199254740992"
    },
    {
      "name": "RFC 8785 Appendix B: 4430000000000000 (~2**68)",
      "input": {
        "ieee754": "4430000000000000"
      },
      "expected": "295147905179352830000"
    },
    {
      "name": "RFC 8785 Appendix B: 7fffffffffffffff (NaN) is refused",
      "input": {
        "ieee754": "7fffffffffffffff"
      },
      "expected": {
        "error": {
          "code": "PREPARE_FAILED",
          "reason": "non-json-settings"
        }
      }
    },
    {
      "name": "RFC 8785 Appendix B: 7ff0000000000000 (Infinity) is refused",
      "input": {
        "ieee754": "7ff0000000000000"
      },
      "expected": {
        "error": {
          "code": "PREPARE_FAILED",
          "reason": "non-json-settings"
        }
      }
    },
    {
      "name": "RFC 8785 Appendix B: 44b52d02c7e14af5 (sample)",
      "input": {
        "ieee754": "44b52d02c7e14af5"
      },
      "expected": "9.999999999999997e+22"
    },
    {
      "name": "RFC 8785 Appendix B: 44b52d02c7e14af6 (sample)",
      "input": {
        "ieee754": "44b52d02c7e14af6"
      },
      "expected": "1e+23"
    },
    {
      "name": "RFC 8785 Appendix B: 44b52d02c7e14af7 (sample)",
      "input": {
        "ieee754": "44b52d02c7e14af7"
      },
      "expected": "1.0000000000000001e+23"
    },
    {
      "name": "RFC 8785 Appendix B: 444b1ae4d6e2ef4e (sample)",
      "input": {
        "ieee754": "444b1ae4d6e2ef4e"
      },
      "expected": "999999999999999700000"
    },
    {
      "name": "RFC 8785 Appendix B: 444b1ae4d6e2ef4f (sample)",
      "input": {
        "ieee754": "444b1ae4d6e2ef4f"
      },
      "expected": "999999999999999900000"
    },
    {
      "name": "RFC 8785 Appendix B: 444b1ae4d6e2ef50 (sample)",
      "input": {
        "ieee754": "444b1ae4d6e2ef50"
      },
      "expected": "1e+21"
    },
    {
      "name": "RFC 8785 Appendix B: 3eb0c6f7a0b5ed8c (sample)",
      "input": {
        "ieee754": "3eb0c6f7a0b5ed8c"
      },
      "expected": "9.999999999999997e-7"
    },
    {
      "name": "RFC 8785 Appendix B: 3eb0c6f7a0b5ed8d (sample)",
      "input": {
        "ieee754": "3eb0c6f7a0b5ed8d"
      },
      "expected": "0.000001"
    },
    {
      "name": "RFC 8785 Appendix B: 41b3de4355555553 (sample)",
      "input": {
        "ieee754": "41b3de4355555553"
      },
      "expected": "333333333.3333332"
    },
    {
      "name": "RFC 8785 Appendix B: 41b3de4355555554 (sample)",
      "input": {
        "ieee754": "41b3de4355555554"
      },
      "expected": "333333333.33333325"
    },
    {
      "name": "RFC 8785 Appendix B: 41b3de4355555555 (sample)",
      "input": {
        "ieee754": "41b3de4355555555"
      },
      "expected": "333333333.3333333"
    },
    {
      "name": "RFC 8785 Appendix B: 41b3de4355555556 (sample)",
      "input": {
        "ieee754": "41b3de4355555556"
      },
      "expected": "333333333.3333334"
    },
    {
      "name": "RFC 8785 Appendix B: 41b3de4355555557 (sample)",
      "input": {
        "ieee754": "41b3de4355555557"
      },
      "expected": "333333333.33333343"
    },
    {
      "name": "RFC 8785 Appendix B: becbf647612f3696 (sample)",
      "input": {
        "ieee754": "becbf647612f3696"
      },
      "expected": "-0.0000033333333333333333"
    },
    {
      "name": "RFC 8785 Appendix B: 43143ff3c1cb0959 (Round to even)",
      "input": {
        "ieee754": "43143ff3c1cb0959"
      },
      "expected": "1424953923781206.2"
    },
    {
      "name": "RFC 8785 3.2.2.2: a lone surrogate, U+DEAD, is refused",
      "input": {
        "jsonText": "\"\\udead\""
      },
      "expected": {
        "error": {
          "code": "PREPARE_FAILED",
          "reason": "non-json-settings"
        }
      }
    },
    {
      "name": "a lone surrogate in a property name is refused",
      "input": {
        "jsonText": "{\"\\ud800\":1}"
      },
      "expected": {
        "error": {
          "code": "PREPARE_FAILED",
          "reason": "non-json-settings"
        }
      }
    }
  ]
}
