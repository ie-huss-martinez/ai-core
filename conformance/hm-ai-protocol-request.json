{
  "format": "hm-conformance",
  "version": 1,
  "subject": "hm-ai-protocol-request",
  "description": "Request bodies of the ai-core/1 protocol, as the handler reads them (docs/formats/hm-ai-protocol.md). input is the parsed body; expected is the body as read, with images still base64, or the rejection's code and reason. Hand-written.",
  "cases": [
    {
      "name": "one user message",
      "input": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      },
      "expected": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "every part type, where each belongs",
      "input": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Look"
              },
              {
                "type": "image",
                "mediaType": "image/png",
                "data": "iVBORw0KGgo="
              }
            ]
          },
          {
            "role": "assistant",
            "parts": [
              {
                "type": "provider-state",
                "provider": "ai-core",
                "data": {
                  "context": "71c702edfb2d7645f1054f9f536a7399d30d4a29aeb9610e6ed5916729c7b1f7"
                }
              },
              {
                "type": "provider-state",
                "provider": "anthropic",
                "data": {
                  "type": "thinking",
                  "thinking": "Hmm.",
                  "signature": "sig"
                },
                "summary": "Hmm."
              },
              {
                "type": "text",
                "text": "Calling.",
                "providerState": {
                  "provider": "gemini",
                  "data": "sig=="
                }
              },
              {
                "type": "tool-call",
                "id": "call_1",
                "name": "look_up",
                "input": {
                  "query": "weather",
                  "units": ["c", null, 1.5, true]
                }
              }
            ]
          },
          {
            "role": "user",
            "parts": [
              {
                "type": "tool-result",
                "callId": "call_1",
                "content": "Sunny",
                "isError": false
              },
              {
                "type": "tool-result",
                "callId": "call_1",
                "content": [
                  {
                    "type": "text",
                    "text": "Rain"
                  },
                  {
                    "type": "image",
                    "mediaType": "image/png",
                    "data": "iVBORw0KGgo="
                  }
                ],
                "isError": true
              }
            ]
          }
        ]
      },
      "expected": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Look"
              },
              {
                "type": "image",
                "mediaType": "image/png",
                "data": "iVBORw0KGgo="
              }
            ]
          },
          {
            "role": "assistant",
            "parts": [
              {
                "type": "provider-state",
                "provider": "ai-core",
                "data": {
                  "context": "71c702edfb2d7645f1054f9f536a7399d30d4a29aeb9610e6ed5916729c7b1f7"
                }
              },
              {
                "type": "provider-state",
                "provider": "anthropic",
                "data": {
                  "type": "thinking",
                  "thinking": "Hmm.",
                  "signature": "sig"
                },
                "summary": "Hmm."
              },
              {
                "type": "text",
                "text": "Calling.",
                "providerState": {
                  "provider": "gemini",
                  "data": "sig=="
                }
              },
              {
                "type": "tool-call",
                "id": "call_1",
                "name": "look_up",
                "input": {
                  "query": "weather",
                  "units": ["c", null, 1.5, true]
                }
              }
            ]
          },
          {
            "role": "user",
            "parts": [
              {
                "type": "tool-result",
                "callId": "call_1",
                "content": "Sunny",
                "isError": false
              },
              {
                "type": "tool-result",
                "callId": "call_1",
                "content": [
                  {
                    "type": "text",
                    "text": "Rain"
                  },
                  {
                    "type": "image",
                    "mediaType": "image/png",
                    "data": "iVBORw0KGgo="
                  }
                ],
                "isError": true
              }
            ]
          }
        ]
      }
    },
    {
      "name": "unicode, escapes and an empty text",
      "input": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "caf\u00e9 \u65e5\u672c \ud83d\ude00 \"q\" \\ \n\u2028"
              },
              {
                "type": "text",
                "text": ""
              }
            ]
          }
        ]
      },
      "expected": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "caf\u00e9 \u65e5\u672c \ud83d\ude00 \"q\" \\ \n\u2028"
              },
              {
                "type": "text",
                "text": ""
              }
            ]
          }
        ]
      }
    },
    {
      "name": "a message with no parts",
      "input": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": []
          },
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      },
      "expected": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "user",
            "parts": []
          },
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "hostile keys inside opaque data are ordinary keys",
      "input": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "assistant",
            "parts": [
              {
                "type": "provider-state",
                "provider": "x",
                "data": {
                  "__proto__": 1,
                  "constructor": 2,
                  "toString": 3
                }
              }
            ]
          },
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      },
      "expected": {
        "protocol": "ai-core/1",
        "messages": [
          {
            "role": "assistant",
            "parts": [
              {
                "type": "provider-state",
                "provider": "x",
                "data": {
                  "__proto__": 1,
                  "constructor": 2,
                  "toString": 3
                }
              }
            ]
          },
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "not an object",
      "input": ["ai-core/1"],
      "expected": {
        "error": {
          "code": "INVALID_REQUEST",
          "reason": "malformed-body"
        }
      }
    },
    {
      "name": "no protocol",
      "input": {
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      },
      "expected": {
        "error": {
          "code": "INVALID_REQUEST",
          "reason": "missing-protocol"
        }
      }
    },
    {
      "name": "a protocol that isn't a string",
      "input": {
        "protocol": 1,
        "messages": [
          {
            "role": "user",
            "parts": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
